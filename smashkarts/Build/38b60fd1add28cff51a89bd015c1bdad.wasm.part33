uniform sampler2D tex;
%svoid main()
{
    vec4 c = SAMPLE_TEXTURE_2D(tex, texCoord);
    FRAG_COLOR = %s;
}
␀%s
%s
precision highp float;
in vec4 vertex;
uniform vec4 uvOffsetAndScale;
out vec2 texCoord;
flat out int stereoTargetEyeIndex;
vec2 maliHack[2] = vec2[](vec2(0, 0), vec2(1, 1));
void main()
{
    gl_Position = vec4(vertex.xy, 0.0, 1.0);
    texCoord = vertex.zw * uvOffsetAndScale.zw + uvOffsetAndScale.xy;
    %s;
}
␀A€“½%s
precision mediump float;
in vec2 texCoord;
flat in int stereoTargetEyeIndex;
out vec4 fragColor;
uniform mediump sampler2DArray tex;
void main()
{
    vec4 c = texture(tex, vec3(texCoord.xy, stereoTargetEyeIndex));
    fragColor = c;
}

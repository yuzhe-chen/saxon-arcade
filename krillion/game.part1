function sfx(k) {
  if (!S.sound) return;
  try {
    AC = AC || new (window.AudioContext || window.webkitAudioContext)();
    if (AC.state === 'suspended') AC.resume();
    if (k === 'ok') { tone(420, 880, 0.16, 'triangle', 0.14); }
    else if (k === 'bad') { tone(180, 120, 0.18, 'square', 0.05); }
    else if (k === 'gem') { [523, 659, 784, 1047].forEach(function (f, i) { tone(f, f, 0.22, 'triangle', 0.12, i * 0.09); }); }
    else if (k === 'descend') { tone(260, 70, 0.9, 'sine', 0.16); }
    else if (k === 'tick') { tone(900, 900, 0.05, 'square', 0.03); }
    else if (k === 'miss') { tone(300, 110, 0.5, 'sawtooth', 0.05); }
    else if (k === 'surface') { [392, 523, 659].forEach(function (f, i) { tone(f, f * 1.01, 0.3, 'triangle', 0.1, i * 0.12); }); }
  } catch (e) {}
}

/* ---------- art (flat objects) ---------- */
function helmet() {
  return '<svg class="pic" viewBox="0 0 64 64"><rect x="14" y="50" width="36" height="9" rx="3" fill="#cd7900"/><circle cx="32" cy="30" r="24" fill="#ffc800"/>' +
    '<path d="M32 6a24 24 0 0 1 0 48z" fill="#e5a400"/><circle cx="32" cy="30" r="13" fill="#e5a400"/><circle cx="32" cy="30" r="10" fill="#a4ceff"/>' +
    '<path d="M25 25a10 10 0 0 1 9-5" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/><circle cx="12" cy="30" r="5" fill="#e5a400"/><circle cx="52" cy="30" r="5" fill="#cd7900"/>' +
    '<circle cx="20" cy="14" r="2" fill="#cd7900"/><circle cx="44" cy="14" r="2" fill="#cd7900"/><circle cx="20" cy="46" r="2" fill="#cd7900"/><circle cx="44" cy="46" r="2" fill="#cd7900"/></svg>';
}
function fishArt(c1, c2) {
  return '<svg class="pic" viewBox="0 0 64 64"><path d="M46 32l14-12v24z" fill="' + c2 + '"/><ellipse cx="30" cy="32" rx="22" ry="16" fill="' + c1 + '"/>' +
    '<path d="M30 16a22 16 0 0 1 0 32z" fill="' + c2 + '" opacity=".35"/><rect x="24" y="17" width="5" height="30" rx="2.5" fill="#fff"/><rect x="36" y="19" width="4" height="26" rx="2" fill="#fff"/>' +
    '<circle cx="16" cy="28" r="4" fill="#fff"/><circle cx="15" cy="28" r="2" fill="#131f24"/><path d="M24 12l8-6 4 8z" fill="' + c2 + '"/></svg>';
}
function squidArt() {
  return '<svg class="pic" viewBox="0 0 64 64"><path d="M32 3l15 25H17z" fill="#ff4b4b"/><rect x="17" y="24" width="30" height="16" rx="8" fill="#ff4b4b"/><path d="M32 3l15 25H32z" fill="#ea2b2b"/>' +
    '<circle cx="25" cy="31" r="4" fill="#fff"/><circle cx="39" cy="31" r="4" fill="#fff"/><circle cx="25" cy="32" r="2" fill="#131f24"/><circle cx="39" cy="32" r="2" fill="#131f24"/>' +
    '<path d="M19 38q-4 12 2 22M26 40q-2 10 2 20M32 40v21M38 40q2 10-2 20M45 38q4 12-2 22" stroke="#ff4b4b" stroke-width="4" fill="none" stroke-linecap="round"/></svg>';
}
function anglerArt() {
  return '<svg class="pic" viewBox="0 0 64 64"><path d="M34 14q8-12 18-8" stroke="#52656d" stroke-width="3" fill="none" stroke-linecap="round"/><circle cx="53" cy="7" r="5" fill="#ffc800"/>' +
    '<path d="M48 34l14-10v20z" fill="#37464f"/><circle cx="28" cy="34" r="22" fill="#52656d"/><path d="M28 12a22 22 0 0 1 0 44z" fill="#37464f"/>' +
    '<path d="M8 38q20 12 34 0z" fill="#131f24"/><path d="M11 39l3 5 3-4 3 5 3-4 3 5 3-4 3 5 3-4 3 5 3-6" stroke="#fff" stroke-width="2" fill="none" stroke-linejoin="round"/>' +
    '<circle cx="22" cy="26" r="5" fill="#fff"/><circle cx="23" cy="26" r="2.5" fill="#131f24"/></svg>';
}
function krillArt(c1, c2) {
  return '<svg class="pic" viewBox="0 0 64 64"><path d="M14 22q-10-14-10-18M18 20q-4-14 0-18" stroke="' + c2 + '" stroke-width="3" fill="none" stroke-linecap="round"/>' +
    '<path d="M12 30q4-14 20-12t24 18q-2 10-12 10-8 0-12-8-6 6-14 2t-6-10z" fill="' + c1 + '"/><path d="M32 18q16 2 24 18-2 10-12 10l-4-28z" fill="' + c2 + '" opacity=".45"/>' +
    '<path d="M28 20v14M36 22v14M44 26v12" stroke="' + c2 + '" stroke-width="3" stroke-linecap="round"/><path d="M50 42l8 12-12-4z" fill="' + c2 + '"/>' +
    '<path d="M22 40v10M28 42v10M34 42v8" stroke="' + c2 + '" stroke-width="3" stroke-linecap="round"/><circle cx="18" cy="26" r="4" fill="#fff"/><circle cx="17" cy="26" r="2" fill="#131f24"/></svg>';
}
function diverArt(id) {
  return id === 'fish' ? fishArt('#ff9600', '#cd7900') : id === 'squid' ? squidArt() : id === 'angler' ? anglerArt() : id === 'gold' ? krillArt('#ffc800', '#e5a400') : helmet();
}
function tank() {
  return '<svg class="pic" viewBox="0 0 64 64"><rect x="26" y="3" width="12" height="8" rx="2" fill="#777"/><rect x="20" y="7" width="24" height="5" rx="2" fill="#afafaf"/>' +
    '<rect x="16" y="12" width="32" height="49" rx="14" fill="#ff4b4b"/><path d="M32 12h2a14 14 0 0 1 14 14v21a14 14 0 0 1-14 14h-2z" fill="#ea2b2b"/>' +
    '<rect x="16" y="30" width="32" height="10" fill="#fff"/><rect x="32" y="30" width="16" height="10" fill="#e5e5e5"/><rect x="22" y="17" width="5" height="11" rx="2.5" fill="#ff8a8a"/></svg>';
}
function stopwatch() {
  return '<svg class="pic" viewBox="0 0 64 64"><rect x="26" y="2" width="12" height="7" rx="2" fill="#3c81db"/><rect x="29" y="8" width="6" height="6" fill="#3c81db"/>' +
    '<circle cx="32" cy="38" r="24" fill="#4b9af3"/><path d="M32 14a24 24 0 0 1 0 48z" fill="#3c81db"/><circle cx="32" cy="38" r="17" fill="#fff"/>' +
    '<path d="M32 38V26" stroke="#ff4b4b" stroke-width="4" stroke-linecap="round"/><path d="M32 38l8 6" stroke="#4b4b4b" stroke-width="4" stroke-linecap="round"/><circle cx="32" cy="38" r="3" fill="#4b4b4b"/></svg>';
}
function scrollArt() {
  return '<svg class="pic" viewBox="0 0 64 64"><rect x="12" y="10" width="40" height="46" rx="6" fill="#ce82ff"/><rect x="12" y="10" width="40" height="10" rx="5" fill="#a568cc"/>' +
    '<rect x="18" y="26" width="28" height="22" rx="3" fill="#fff"/><path d="M22 32h20M22 38h14M22 44h18" stroke="#ce82ff" stroke-width="3" stroke-linecap="round"/></svg>';
}
function chestArt() {
  return '<svg class="pic" viewBox="0 0 64 64"><rect x="6" y="26" width="52" height="30" rx="4" fill="#cd7900"/><rect x="32" y="26" width="26" height="30" rx="4" fill="#a86300"/>' +
    '<path d="M6 30q0-20 26-20t26 20z" fill="#ff9600"/><path d="M32 10q26 0 26 20H32z" fill="#cd7900"/><rect x="6" y="26" width="52" height="5" fill="#ffc800"/>' +
    '<rect x="27" y="24" width="10" height="13" rx="3" fill="#ffc800"/><rect x="30.5" y="29" width="3" height="4" fill="#a86300"/></svg>';
}
function soundIcon(on) {
  return on ? '<svg viewBox="0 0 24 24"><path d="M3 9h4l5-4v14l-5-4H3z" fill="currentColor"/><path d="M16 8q3 4 0 8M19 5q5 7 0 14" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round"/></svg>'
    : '<svg viewBox="0 0 24 24"><path d="M3 9h4l5-4v14l-5-4H3z" fill="currentColor"/><path d="M16 9l6 6M22 9l-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>';
}
function heroArt() {
  var w = 760, s = '<svg viewBox="0 0 760 230" preserveAspectRatio="xMidYMid slice">';
  var bh = [0, 46, 92, 138, 184];
  [BANDS[0], BANDS[1], BANDS[3], BANDS[5], BANDS[7]].forEach(function (c, i) { s += '<rect x="0" y="' + bh[i] + '" width="' + w + '" height="47" fill="' + c + '"/>'; });
  s += '<rect x="186" y="0" width="4" height="96" fill="#e5a400"/><g transform="translate(156 86)">' + helmet().replace('<svg class="pic" viewBox="0 0 64 64">', '<svg width="64" height="64" viewBox="0 0 64 64">') + '</g>';
  [[232, 70, 7], [246, 46, 5], [238, 24, 4], [520, 120, 6], [532, 96, 4], [96, 150, 5], [108, 128, 3]].forEach(function (b) { s += '<circle cx="' + b[0] + '" cy="' + b[1] + '" r="' + b[2] + '" fill="#e6f1ff"/>'; });
  s += '<g transform="translate(400 60) scale(.9)">' + fishArt('#ff9600', '#cd7900').replace('<svg class="pic" viewBox="0 0 64 64">', '<svg width="64" height="64" viewBox="0 0 64 64">') + '</g>';
  s += '<g transform="translate(470 128) scale(.8)">' + squidArt().replace('<svg class="pic" viewBox="0 0 64 64">', '<svg width="64" height="64" viewBox="0 0 64 64">') + '</g>';
  s += '<path d="M0 230V206q40-18 90-8t80 2 70 6 0 24z" fill="#37464f"/><path d="M430 230v-18q50-26 120-14t110 2 100 8v22z" fill="#2a363d"/>';
  s += '<path d="M60 206c-10-30 14-40 4-70 14 22-4 40 6 70z" fill="#58a700"/><path d="M76 206c-6-24 10-36 2-56 12 18 0 34 6 56z" fill="#58cc02"/>';
  s += '<path d="M690 214c-10-32 14-44 4-76 14 24-4 44 6 76z" fill="#58a700"/><path d="M706 214c-6-26 10-38 2-60 12 20 0 36 6 60z" fill="#58cc02"/>';
  s += '<g transform="translate(560 160)"><rect x="0" y="22" width="76" height="40" rx="4" fill="#cd7900"/><rect x="38" y="22" width="38" height="40" rx="4" fill="#a86300"/>' +
    '<path d="M0 26q0-24 38-24t38 24z" fill="#ff9600"/><path d="M38 2q38 0 38 24H38z" fill="#cd7900"/><rect x="0" y="22" width="76" height="6" fill="#ffc800"/>' +
    '<rect x="32" y="20" width="12" height="16" rx="3" fill="#ffc800"/><rect x="36" y="27" width="4" height="5" fill="#a86300"/></g>';
  s += '<g transform="translate(330 150)" fill="#52656d"><circle cx="20" cy="6" r="6" fill="none" stroke="#52656d" stroke-width="4"/><rect x="18" y="11" width="4" height="40"/><rect x="8" y="18" width="24" height="4" rx="2"/>' +
    '<path d="M2 36q2 18 18 18t18-18l-6 4q-2 8-12 8t-12-8z"/></g>';
  return s + '</svg>';
}

/* ---------- ui helpers ---------- */
var $app = document.getElementById('app');
function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
function fmt(n) { return Math.round(n).toLocaleString('en-US'); }
function zoneName(m) { return m < 200 ? 'Sunlight Zone' : m < 1000 ? 'Twilight Zone' : m < 4000 ? 'Midnight Zone' : m < 6000 ? 'Abyssal Zone' : 'Hadal Zone'; }
function verdict(score) { var v = VERDICTS[0]; VERDICTS.forEach(function (x) { if (score >= x[0]) v = x; }); return v; }
function bandOf(m) { return Math.max(0, Math.min(BANDS.length - 1, Math.floor(m / 1000))); }
function inkOf(i) { return i === 0 ? '#0b3a6b' : '#fff'; }
function pill(t, txt) { return '<span class="pill t' + t + '">' + esc(txt || TIERS[t].n) + '</span>'; }
function diverNow() { return diverArt(S.diver); }
var timer = null;
function stopTimer() { if (timer) { clearInterval(timer); timer = null; } }
var homeBtn = document.getElementById('bHome');
function toast(t) { var d = document.createElement('div'); d.className = 'toast'; d.textContent = t; document.body.appendChild(d); setTimeout(function () { d.remove(); }, 1800); }
function show(h, top) { $app.innerHTML = h; if (top !== false) window.scrollTo(0, 0); }

/* ---------- home ---------- */
function home() {
  stopTimer(); run = null; homeBtn.hidden = true;
  var day = today(), d = S.daily && S.daily.day === day ? S.daily : null, done = d && d.ans.length >= DAILY_N;
  var dm = d ? d.score * 10 : 0, nextIn = (day + 1) * 864e5 - Date.now(), hh = Math.floor(nextIn / 36e5), mm = Math.floor(nextIn % 36e5 / 6e4);
  var h = '<div class="wrap"><div class="hero">' + heroArt() + '</div>' +
    '<div class="hhead"><h1>The Daily Dive</h1><div class="lbl">Dive ' + (day - DAY0 + 1) + ', ' + esc(dateLabel(day)) + '</div></div>' +
    '<div class="card daily"><div class="ic">' + helmet() + '</div><div style="min-width:0"><h2>Daily Dive</h2>' +
    (done ? '<div class="res"><b>' + fmt(dm) + ' m</b><span class="sub">' + esc(zoneName(dm)) + '</span></div><div class="sub">Next dive in ' + hh + 'h ' + mm + 'm</div>'
      : d && d.ans.length ? '<div class="res"><b>' + fmt(dm) + ' m</b><span class="sub">' + d.ans.length + ' of 7 done</span></div>'
      : '<div class="sub">7 prompts, 25 seconds each, one try a day</div><div class="res"><span class="sub">Streak</span><b>' + streakNow() + '</b></div>') +
    '</div><button class="btn acc" id="bDaily" type="button">' + (done ? 'Results' : d && d.ans.length ? 'Continue' : 'Begin descent') + '</button></div>' +
    '<div class="modes">' +
    modeCard('bEndless', tank(), 'Endless Dive', 'Fresh 7-prompt dives, back to back', S.endlessDives ? '<span class="sub">Best</span><b>' + fmt(S.bestEndless) + ' m</b><span class="sub">' + S.endlessDives + ' surfaced</span>' : '', 'Descend', 'blu') +
    modeCard('bFree', stopwatch(), 'Free Dive', '60 seconds, one prompt, as many answers as you can', S.freeRuns ? '<span class="sub">Best</span><b>' + fmt(S.freeBest) + '</b><span class="sub">points</span>' : '', 'Hold breath', 'blu') +
    modeCard('bThemes', chestArt(), 'Themed Dives', THEMES.length + ' themes, from food to fiction', '', 'Pick a theme', '') +
    modeCard('bArch', scrollArt(), 'Archive', 'Replay any past Daily Dive', '', 'Open archive', '') +
    '</div>' +
    '<div class="stats">' +
    '<div class="card stat"><div class="lbl">Streak</div><div class="v g">' + streakNow() + '</div></div>' +
    '<div class="card stat"><div class="lbl">Best streak</div><div class="v">' + S.bestStreak + '</div></div>' +
    '<div class="card stat"><div class="lbl">Best daily</div><div class="v">' + fmt(S.bestDaily) + ' m</div></div>' +
    '<div class="card stat"><div class="lbl">Dives</div><div class="v">' + S.dives + '</div></div></div>' +
    '<div class="card crew"><div class="lbl">Your diver</div><div class="row">' +
    DIVERS.map(function (x) { var lock = S.bestStreak < x.at; return '<button class="pal' + (lock ? ' lock' : '') + (S.diver === x.id ? ' on' : '') + '" type="button" data-d="' + x.id + '"' + (lock ? ' aria-disabled="true"' : '') + '>' +
      diverArt(x.id) + '<span>' + esc(lock ? 'Streak ' + x.at : x.n) + '</span></button>'; }).join('') +
    '</div></div></div>';
  show(h);
  document.getElementById('bDaily').onclick = function () { if (done) endScreen(dailyRun()); else startDaily(); };
  document.getElementById('bEndless').onclick = startEndless;
  document.getElementById('bFree').onclick = startFree;
  document.getElementById('bThemes').onclick = themesScreen;
  document.getElementById('bArch').onclick = function () { archiveScreen(30); };
  Array.prototype.forEach.call(document.querySelectorAll('.pal'), function (b) {
    b.onclick = function () { var x = DIVERS.filter(function (y) { return y.id === b.dataset.d; })[0]; if (!x) return;
      if (S.bestStreak < x.at) { toast('Reach a ' + x.at + ' day streak to unlock ' + x.n); return; }
      S.diver = x.id; save(); home(); window.scrollTo(0, document.body.scrollHeight); };
  });
}
function modeCard(id, art, name, sub, res, cta, cls) {
  return '<div class="card mode"><div class="mh"><div class="ic">' + art + '</div><div style="min-width:0"><h2>' + esc(name) + '</h2><div class="sub">' + esc(sub) + '</div></div></div>' +
    (res ? '<div class="res">' + res + '</div>' : '') + '<button class="btn wide ' + (cls || '') + '" id="' + id + '" type="button">' + esc(cta) + '</button></div>';
}

/* ---------- themes and archive ---------- */
function themesScreen() {
  stopTimer(); run = null; homeBtn.hidden = false;
  var h = '<div class="wrap"><div class="shead"><h1>Themed Dives</h1><div class="lbl">7 prompts per dive</div></div><div class="themes">';
  THEMES.forEach(function (t) {
    var n = DATA.filter(function (P) { return P.th === t.id; }).length; if (n < DAILY_N) return;
    var best = S.themes[t.id] || 0;
    h += '<button class="card theme" type="button" data-t="' + t.id + '"><div class="tt"><i style="background:' + t.c + '">' + esc(t.n.charAt(0)) + '</i><b>' + esc(t.n) + '</b></div>' +
      '<div class="sub">' + n + ' prompts' + (best ? ', best ' + fmt(best * 10) + ' m' : '') + '</div></button>';
  });
  h += '</div></div>';
  show(h);
  Array.prototype.forEach.call(document.querySelectorAll('.theme'), function (b) { b.onclick = function () { startTheme(b.dataset.t); }; });
}
function archiveScreen(limit) {
  stopTimer(); run = null; homeBtn.hidden = false;
  var day = today(), first = Math.max(DAY0, day - 365), rows = '', n = 0;
  for (var d = day - 1; d >= first && n < limit; d--, n++) {
    var a = S.arch[d], hs = S.hist[d], sc = a ? a.score : hs != null ? hs : null;
    rows += '<div class="card arow"><div class="l"><b>Dive ' + (d - DAY0 + 1) + '</b><span class="sub">' + esc(dateLabel(d)) + '</span></div><div class="r">' +
      (sc != null ? '<span class="m">' + fmt(sc * 10) + ' m</span>' : '<span class="sub">Not played</span>') +
      '<button class="btn sm' + (sc != null ? ' ghost' : ' acc') + '" type="button" data-d="' + d + '">' + (sc != null ? 'Replay' : 'Play') + '</button></div></div>';
  }
  var h = '<div class="wrap"><div class="shead"><h1>Archive</h1><div class="lbl">Replays do not touch your streak</div></div><div class="rows">' + (rows || '<div class="sub">No past dives yet.</div>') + '</div>' +
    (day - 1 - n >= first ? '<div class="acts"><button class="btn ghost wide" id="bMore" type="button">Show more</button></div>' : '') + '</div>';
  var y = window.scrollY;
  show(h, limit <= 30);
  if (limit > 30) window.scrollTo(0, y);
  Array.prototype.forEach.call(document.querySelectorAll('.arow .btn'), function (b) { b.onclick = function () { startArchive(+b.dataset.d); }; });
  var m = document.getElementById('bMore'); if (m) m.onclick = function () { archiveScreen(limit + 30); };
}

/* ---------- dives (daily, endless, archive, theme) ---------- */
var run = null;
function dailyRun() {
  var day = today();
  if (!S.daily || S.daily.day !== day) S.daily = { day: day, set: dailySet(day), ans: [], score: 0 };
  return { mode: 'daily', day: day, set: S.daily.set, ans: S.daily.ans, score: S.daily.score, i: S.daily.ans.length };
}
function startDaily() {
  run = dailyRun();
  if (!run.ans.length && !S.daily.pend) { S.dives++; save(); }
  playScreen(); beginRound();
}
function startEndless() {
  var e = S.endless;
  if (!e || typeof e.seed !== 'number' || typeof e.pos !== 'number') e = S.endless = { seed: (Date.now() ^ (Math.random() * 1e9)) >>> 0, pos: 0 };
  var order = shuffle(ALL.slice(), rng(e.seed)), set = [];
  for (var k = 0; k < order.length && set.length < DAILY_N; k++) { var i = order[(e.pos + k) % order.length]; set.push(i); }
  e.pos += DAILY_N; if (e.pos >= order.length) { e.seed = (e.seed * 31 + 7) >>> 0; e.pos = 0; }
  S.dives++; save();
  run = { mode: 'endless', set: set, ans: [], score: 0, i: 0, n: S.endlessDives + 1 };
  playScreen(); beginRound();
}
function startArchive(day) {
  var a = S.arch[day];
  var set = a && Array.isArray(a.set) && a.set.every(function (i) { return DATA[i]; }) ? a.set : dailySet(day);
  S.dives++; save();
  run = { mode: 'archive', day: day, set: set, ans: [], score: 0, i: 0 };
  playScreen(); beginRound();
}
function startTheme(id) {
  var pool = DATA.filter(function (P) { return P.th === id; }).map(function (P) { return P.i; });
  var set = shuffle(pool, rng((Date.now() ^ (Math.random() * 1e9)) >>> 0)).slice(0, DAILY_N);
  S.dives++; save();
  run = { mode: 'theme', theme: id, set: set, ans: [], score: 0, i: 0 };
  playScreen(); beginRound();
}
function depth() { return run.score * 10; }
function modeLabel(r) {
  return r.mode === 'daily' ? 'Daily Dive ' + (r.day - DAY0 + 1) : r.mode === 'archive' ? 'Archive Dive ' + (r.day - DAY0 + 1) :
    r.mode === 'endless' ? 'Endless Dive ' + r.n : r.mode === 'theme' ? themeName(r.theme) + ' Dive' : 'Free Dive';
}
function themeName(id) { var t = THEMES.filter(function (x) { return x.id === id; })[0]; return t ? t.n : 'Themed'; }

function meterHTML() {
  var max = 7000, n = 7, h = '';
  for (var i = 0; i < n; i++) h += '<div class="band" style="background:' + BANDS[Math.min(i, BANDS.length - 1)] + ';color:' + inkOf(i) + '">' + (i ? '<span>' + i + 'k</span>' : '') + '</div>';
  var pct = 4 + Math.min(1, depth() / max) * 92;
  return h + '<div class="mk" id="mk" style="top:' + pct + '%"><i></i>' + diverNow() + '</div>';
}
function playScreen() {
  homeBtn.hidden = false;
  show('<div class="wrap"><div class="play"><div class="meter" id="meter"></div><div class="mcol">' +
    '<div class="phead"><div class="depth" id="dep"></div><div class="dots" id="dots"></div></div>' +
    '<div class="stage" id="stage"><div class="lbl" id="qn"></div><div class="q" id="q"></div>' +
    '<div class="tbar" id="tbar"></div></div>' +
    '<div id="below"></div></div></div></div>');
  document.getElementById('meter').innerHTML = meterHTML();
}
function paintHead() {
  var mk = document.getElementById('mk');
  if (mk) mk.style.top = (4 + Math.min(1, depth() / 7000) * 92) + '%';
  document.getElementById('dep').innerHTML = fmt(depth()) + '<small>m</small>';
  var dots = '';
  for (var i = 0; i < DAILY_N; i++) dots += '<i class="' + (i < run.ans.length ? 't' + run.ans[i].t + 'b' : i === run.i ? 'cur' : '') + '"></i>';
  document.getElementById('dots').innerHTML = dots;
  var b = bandOf(depth()), st = document.getElementById('stage');
  st.style.background = BANDS[b]; st.style.color = inkOf(b);
}
function curP() { return DATA[run.set[run.i]]; }
function bubbles(n) {
  var st = document.getElementById('stage'); if (!st) return;
  for (var k = 0; k < n; k++) { var b = document.createElement('i'), s = 6 + Math.random() * 14; b.className = 'bub';
    b.style.cssText = 'left:' + (5 + Math.random() * 90) + '%;width:' + s + 'px;height:' + s + 'px;animation-delay:' + (Math.random() * .8) + 's';
    st.appendChild(b); setTimeout(function (x) { return function () { x.remove(); }; }(b), 3600); }
}
function answerForm(free) {
  return '<form class="ans" id="fa" autocomplete="off"><input class="field" id="inp" maxlength="60" placeholder="Your answer" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go">' +
    '<button class="btn acc" type="submit" id="bGo">' + (free ? 'Catch' : 'Dive') + '</button></form><div class="msg" id="msg"></div>';
}
/* a round: the prompt appears while you descend, then the 25 second clock starts */
function beginRound() {
  stopTimer();
  if (run.i >= DAILY_N || run.i >= run.set.length) { finishDive(); return; }
  var P = curP();
  paintHead();
  document.getElementById('qn').textContent = 'Prompt ' + (run.i + 1) + ' of ' + DAILY_N;
  document.getElementById('q').textContent = P.show;
  document.getElementById('below').innerHTML = answerForm(false);
  var inp = document.getElementById('inp');
  document.getElementById('fa').onsubmit = function (e) { e.preventDefault(); submit(inp.value); };
  inp.oninput = function () { inp.classList.remove('bad'); var m = document.getElementById('msg'); m.textContent = ''; m.className = 'msg'; };
  setTimeout(function () { try { inp.focus({ preventScroll: true }); } catch (e) {} }, 30);
  /* a daily round that was already running when the page closed keeps its clock */
  var pend = run.mode === 'daily' && S.daily.pend && S.daily.pend.i === run.i ? S.daily.pend : null;
  if (pend) { var left = ROUND_T - (Date.now() - pend.at) / 1000; if (left <= 0) { timeUp(); return; } startClock(left); return; }
  run.phase = 'preview';
  var st = document.getElementById('stage'); st.classList.add('pv'); bubbles(12);
  var n = PREVIEW_T, tb = document.getElementById('tbar');
  function paint() { tb.innerHTML = '<span class="pvt">' + (run.i ? 'Descending' : 'Diving in') + ', the clock starts in<b>' + n + '</b></span>'; }
  paint();
  timer = setInterval(function () { n--; if (n <= 0) { stopTimer(); st.classList.remove('pv'); startClock(ROUND_T); } else paint(); }, 1000);
}
function startClock(left0) {
  stopTimer();
  run.phase = 'round';
  var t0 = performance.now(), lastS = -1;
  if (run.mode === 'daily') { S.daily.pend = { i: run.i, at: Date.now() - (ROUND_T - left0) * 1000 }; save(); }
  document.getElementById('tbar').innerHTML = '<div class="tr"><i id="tf"></i></div><b id="tt"></b>';
  function tick() {
    var left = left0 - (performance.now() - t0) / 1000, f = document.getElementById('tf'), tt = document.getElementById('tt');
    if (!f) { stopTimer(); return; }
    f.style.width = Math.max(0, Math.min(100, left / ROUND_T * 100)) + '%';
    f.className = left <= 5 ? 'cr' : left <= 10 ? 'lo' : '';
    var s = Math.max(0, Math.ceil(left)); tt.textContent = s + 's';
    if (s !== lastS && s <= 5 && s > 0) sfx('tick'); lastS = s;
    if (left <= 0) { stopTimer(); timeUp(); }
  }
  tick(); timer = setInterval(tick, 100);
}
function reject(v, inp, msg) {
  inp.classList.remove('shake'); void inp.offsetWidth; inp.classList.add('bad', 'shake');
  msg.className = 'msg'; msg.textContent = 'No match for "' + String(v).trim().slice(0, 40) + '". Try again.';
  sfx('bad');
}
function submit(v) {
  if (!run || run.phase === 'feedback') return;
  var P = curP(), inp = document.getElementById('inp'), msg = document.getElementById('msg');
  if (!norm(v)) return;
  if (run.phase === 'preview') { msg.className = 'msg ok'; msg.textContent = 'Hold on, the clock has not started yet.'; return; }
  var e = check(P, v);
  if (!e) { reject(v, inp, msg); return; }
  stopTimer();
  record({ i: P.i, q: P.q, a: e.name, t: e.t, p: TIERS[e.t].p, typed: String(v).trim().slice(0, 60) });
  feedback(P, e);
}
function record(a) {
  run.ans.push(a); run.score += a.p; run.i++; run.phase = 'feedback';
  if (run.mode === 'daily') { S.daily.ans = run.ans; S.daily.score = run.score; S.daily.pend = null; save(); }
}
function timeUp() {
  var P = curP();
  record({ i: P.i, q: P.q, a: '', t: 0, p: 0 });
  feedback(P, null);
}
function sonarHTML(e, base) {
  var h = '<div class="sonar' + (e ? '' : ' miss') + '" id="sonar" style="background:linear-gradient(180deg,' + BANDS[1] + ',' + BANDS[4] + ' 55%,' + BANDS[7] + ')">';
  for (var t = 1; t <= 6; t++) {
    h += '<div class="sl' + (e && e.t === t ? ' me' : '') + '" style="top:' + (TIERS[t].dp * 100) + '%"><span><i class="dot t' + t + '"></i>' + esc(TIERS[t].n) + ' +' + TIERS[t].p + '</span><em>' + fmt(base + TIERS[t].p * 10) + ' m</em></div>';
  }
  return h + '<div class="sm" id="sm">' + diverNow() + '</div></div>';
}
function feedback(P, e) {
  ensure(P); run.phase = 'feedback';
  var t = e ? e.t : 0, last = run.i >= DAILY_N, base = depth() - (e ? TIERS[t].p * 10 : 0);
  paintHead();
  document.getElementById('tbar').innerHTML = '';
  sfx(!e ? 'miss' : t === 6 ? 'gem' : 'ok');
  var gem = P.gem, deep = P.all.filter(function (x) { return x.t === 5 && x !== e; }).slice(0, 3);
  var gemLine = gem && gem !== e ? '<div class="rare"><span class="lbl">The gem</span><span><i class="dot t6"></i>' + esc(gem.name) + '</span></div>' : '';
  var deepLine = deep.length ? '<div class="rare"><span class="lbl">Deep cuts</span>' + deep.map(function (x) { return '<span><i class="dot t5"></i>' + esc(x.name) + '</span>'; }).join('') + '</div>' : '';
  document.getElementById('below').innerHTML = '<div class="card result' + (t === 6 ? ' gem' : '') + '">' +
    '<div class="top2">' + pill(t, e ? null : 'Out of time') + '<span class="pts">+' + TIERS[t].p + (e ? '<small>' + fmt(TIERS[t].p * 10) + ' m deeper</small>' : '') + '</span></div>' +
    '<div class="an' + (e ? '' : ' none') + '">' + (e ? esc(e.name) : 'The clock won this one') + '</div>' +
    '<div class="bl">' + esc(e ? TIERS[t].b : 'No answer, no depth. ' + (last ? 'Time to surface.' : 'Shake it off and keep going.')) + '</div>' +
    sonarHTML(e, base) + gemLine + deepLine +
    '<div class="rbtns"><button class="btn acc" id="bNext" type="button">' + (last ? 'Surface' : 'Descend') + '</button><button class="btn ghost" id="bAll" type="button">All ' + fmt(P.all.length) + ' answers</button></div></div>';
  requestAnimationFrame(function () { requestAnimationFrame(function () { var sm = document.getElementById('sm'); if (sm) sm.style.top = (e ? TIERS[t].dp * 100 : 6) + '%'; }); });
  var b = document.getElementById('bNext');
  b.onclick = function () { if (!last) sfx('descend'); beginRound(); };
  document.getElementById('bAll').onclick = function () { openAnswers(P, e ? e.name : null); };
  setTimeout(function () { try { b.focus({ preventScroll: true }); } catch (x) {} }, 30);
}
function finishDive() {
  stopTimer(); sfx('surface');
  var r = run;
  if (r.mode === 'daily') {
    var day = r.day;
    if (!S.daily.counted) {
      S.daily.counted = 1;
      if (S.lastDone !== day) { S.streak = S.lastDone === day - 1 ? S.streak + 1 : 1; S.lastDone = day; }
      S.bestStreak = Math.max(S.bestStreak, S.streak);
      S.bestDaily = Math.max(S.bestDaily, r.score * 10);
      S.hist[day] = r.score;
    }
  } else if (r.mode === 'endless') {
    S.endlessDives++; S.bestEndless = Math.max(S.bestEndless, r.score * 10);
  } else if (r.mode === 'archive') {
    var a = S.arch[r.day];
    if (!a || r.score >= a.score) S.arch[r.day] = { score: r.score, set: r.set, tiers: r.ans.map(function (x) { return x.t; }) };
  } else if (r.mode === 'theme') {
    S.themes[r.theme] = Math.max(S.themes[r.theme] || 0, r.score);
  }
  save();
  endScreen(r);
}

/* ---------- end ---------- */
function shareText(r) {
  var m = r.score * 10;
  return 'Krillion ' + modeLabel(r) + '\n' + r.ans.map(function (a) { return TIERS[a.t].e; }).join('') + '\n' + fmt(m) + ' m, ' + zoneName(m) + ' (' + r.score + ' points)';
}
function copy(text, btn) {
  function ok() { btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = 'Share'; }, 1600); }
  function fb() { var ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch (e) {} ta.remove(); ok(); }
  try { navigator.clipboard.writeText(text).then(ok, fb); } catch (e) { fb(); }
}
function chartHTML(ans) {
  var cols = 'grid-template-columns:repeat(' + DAILY_N + ',1fr)', h = '<div class="chart" style="background:linear-gradient(180deg,' + BANDS[1] + ',' + BANDS[4] + ' 55%,' + BANDS[7] + ')">';
  [['Surface', 0], ['Rare', TIERS[4].dp], ['Trench', TIERS[6].dp]].forEach(function (g) { h += '<div class="gl" style="top:' + (g[1] * 100) + '%"><span>' + g[0] + '</span></div>'; });
  h += '<div class="cols" style="' + cols + '">';
  for (var i = 0; i < DAILY_N; i++) {
    var a = ans[i], t = a ? a.t : -1, top = a ? (a.t ? TIERS[a.t].dp : TIERS[0].dp) * 100 : -1;
    h += '<div class="col">' + (a ? '<i class="stem" style="height:' + top + '%"></i><i class="bd t' + t + 'b" style="top:' + top + '%;animation-delay:' + (i * 90) + 'ms" title="' + esc((i + 1) + ': ' + (a.a || 'missed') + ', ' + a.p + ' points') + '"></i>' : '') + '</div>';
  }
  h += '</div></div><div class="cnum" style="' + cols + '">';
  for (i = 0; i < DAILY_N; i++) h += '<span>' + (i + 1) + '</span>';
  return h + '</div>';
}
function endScreen(r) {
  stopTimer(); run = null; homeBtn.hidden = false;
  var m = r.score * 10, b = bandOf(m), v = verdict(r.score);
  var best = r.mode === 'daily' ? S.bestDaily : r.mode === 'endless' ? S.bestEndless : r.mode === 'theme' ? (S.themes[r.theme] || 0) * 10 : S.arch[r.day] ? S.arch[r.day].score * 10 : m;
  var valid = r.ans.filter(function (a) { return a.t > 0; }).length, gems = r.ans.filter(function (a) { return a.t === 6; }).length;
  var h = '<div class="wrap"><div class="sum" style="background:' + BANDS[b] + ';color:' + inkOf(b) + '">' +
    '<div class="lbl">' + esc(modeLabel(r)) + ' complete</div>' +
    '<div class="huge">' + fmt(m) + ' m</div><div class="zn">' + esc(zoneName(m)) + '</div><div class="vd">' + esc(v[1]) + '</div>' +
    '<div class="row3"><span>' + fmt(r.score) + ' points</span><span>' + valid + ' of ' + DAILY_N + ' answered</span>' + (gems ? '<span>' + gems + (gems > 1 ? ' gems' : ' gem') + '</span>' : '') +
    (r.mode === 'daily' ? '<span>Streak ' + streakNow() + '</span>' : '') + '<span>Best ' + fmt(best) + ' m</span></div></div>' +
    '<div class="acts"><button class="btn acc" id="bShare" type="button">Share</button>' +
    (r.mode === 'endless' ? '<button class="btn blu" id="bAgain" type="button">Next dive</button>' : r.mode === 'theme' ? '<button class="btn blu" id="bAgain" type="button">Another ' + esc(themeName(r.theme)) + ' dive</button>' : '') +
    '<button class="btn ghost" id="bBack" type="button">Home</button></div>' +
    '<div class="card log"><div class="lh"><span class="lbl">Dive log</span><span class="lbl">Deeper is rarer</span></div>' + chartHTML(r.ans) + '</div>' +
    '<div class="list">';
  r.ans.forEach(function (a, k) {
    var P = ensure(promptOf(a)); if (!P) return;
    h += '<button class="card it" type="button" data-k="' + k + '"><div class="qh"><div class="q">' + esc(P.show) + '</div><span class="p">+' + a.p + '</span></div><div class="me">' +
      (a.t ? pill(a.t) + '<span>' + esc(a.a) + '</span>' : pill(0, 'Out of time')) + '</div>' +
      (P.gem && P.gem.name !== a.a ? '<div class="rare"><span class="lbl">The gem</span><span><i class="dot t6"></i>' + esc(P.gem.name) + '</span></div>' : '') +
      '<span class="more">All ' + fmt(P.all.length) + ' answers</span></button>';
  });
  h += '</div></div>';
  show(h);
  document.getElementById('bShare').onclick = function () { copy(shareText(r), this); };
  document.getElementById('bBack').onclick = home;
  var ag = document.getElementById('bAgain');
  if (ag) ag.onclick = r.mode === 'endless' ? startEndless : function () { startTheme(r.theme); };
  Array.prototype.forEach.call(document.querySelectorAll('.it'), function (el) { el.onclick = function () { var a = r.ans[+el.dataset.k]; openAnswers(promptOf(a), a.a || null); }; });
}

/* ---------- free dive: 60 seconds, as many answers as you can ---------- */
function startFree() {
  stopTimer(); homeBtn.hidden = false;
  var pool = DATA.filter(function (P) { return P.n >= 80; }), P = ensure(pool[Math.floor(Math.random() * pool.length)]);
  run = { mode: 'free', P: P, got: [], score: 0, phase: 'preview' };
  S.dives++; S.freeRuns++; save();
  show('<div class="wrap"><div class="stage" id="stage" style="background:' + BANDS[1] + ';color:#fff"><div class="lbl">Free Dive</div><div class="q" id="q"></div>' +
    '<div class="tbar" id="tbar"></div></div><div id="below"></div></div>');
  document.getElementById('q').textContent = P.show;
  document.getElementById('below').innerHTML = answerForm(true) + '<div class="phead" style="margin:6px 0 0"><div class="depth" id="fsc">0<small>points</small></div><span class="lbl" id="fn">0 caught</span></div><div class="chips" id="chips"></div>';
  var inp = document.getElementById('inp');
  document.getElementById('fa').onsubmit = function (e) { e.preventDefault(); freeSubmit(inp.value); };
  inp.oninput = function () { inp.classList.remove('bad'); var m = document.getElementById('msg'); m.textContent = ''; m.className = 'msg'; };
  setTimeout(function () { try { inp.focus({ preventScroll: true }); } catch (e) {} }, 30);
  var n = PREVIEW_T, tb = document.getElementById('tbar');
  function paint() { tb.innerHTML = '<span class="pvt">Deep breath, the clock starts in<b>' + n + '</b></span>'; }
  paint(); bubbles(10);
  timer = setInterval(function () { n--; if (n > 0) { paint(); return; } stopTimer(); freeClock(); }, 1000);
}
function freeClock() {
  run.phase = 'round';
  var t0 = performance.now(), lastS = -1;
  document.getElementById('tbar').innerHTML = '<div class="tr"><i id="tf"></i></div><b id="tt"></b>';
  timer = setInterval(function () {
    var left = FREE_T - (performance.now() - t0) / 1000, f = document.getElementById('tf');
    if (!f) { stopTimer(); return; }
    f.style.width = Math.max(0, left / FREE_T * 100) + '%'; f.className = left <= 5 ? 'cr' : left <= 10 ? 'lo' : '';
    var s = Math.max(0, Math.ceil(left)); document.getElementById('tt').textContent = s + 's';
    if (s !== lastS && s <= 5 && s > 0) sfx('tick'); lastS = s;
    if (left <= 0) { stopTimer(); freeEnd(); }
  }, 100);
}
function freeSubmit(v) {
  if (!run || run.mode !== 'free' || run.phase === 'done') return;
  var inp = document.getElementById('inp'), msg = document.getElementById('msg');
  if (!norm(v)) return;
  if (run.phase === 'preview') { msg.className = 'msg ok'; msg.textContent = 'Hold on, the clock has not started yet.'; return; }
  var e = check(run.P, v);
  if (!e) { reject(v, inp, msg); return; }
  if (run.got.indexOf(e) >= 0) { inp.classList.remove('shake'); void inp.offsetWidth; inp.classList.add('bad', 'shake'); msg.className = 'msg'; msg.textContent = 'Already caught ' + e.name + '.'; sfx('bad'); return; }
  run.got.push(e); run.score += TIERS[e.t].p; sfx(e.t === 6 ? 'gem' : 'ok');
  inp.value = ''; msg.className = 'msg ok'; msg.textContent = e.name + ', ' + TIERS[e.t].n + ', +' + TIERS[e.t].p;
  document.getElementById('fsc').innerHTML = fmt(run.score) + '<small>points</small>';
  document.getElementById('fn').textContent = run.got.length + ' caught';
  document.getElementById('chips').insertAdjacentHTML('afterbegin', '<span class="chip"><i class="dot t' + e.t + '"></i>' + esc(e.name) + '<small>+' + TIERS[e.t].p + '</small></span>');
}
function freeEnd() {
  var r = run; r.phase = 'done'; sfx('surface');
  var isBest = r.score > S.freeBest; if (isBest) S.freeBest = r.score; save();
  var m = Math.min(r.score, 7000) * 10, b = bandOf(m);
  var missed = r.P.all.filter(function (x) { return x.t >= 5 && r.got.indexOf(x) < 0; }).slice(0, 4);
  var h = '<div class="wrap"><div class="sum" style="background:' + BANDS[b] + ';color:' + inkOf(b) + '"><div class="lbl">Free Dive complete</div>' +
    '<div class="huge">' + fmt(r.score) + '</div><div class="zn">points from ' + r.got.length + (r.got.length === 1 ? ' answer' : ' answers') + '</div>' +
    '<div class="row3"><span>' + esc(isBest ? 'New best' : 'Best ' + fmt(S.freeBest)) + '</span><span>' + fmt(r.P.all.length) + ' answers on the list</span></div></div>' +
    '<div class="acts"><button class="btn acc" id="bShare" type="button">Share</button><button class="btn blu" id="bAgain" type="button">Free dive again</button><button class="btn ghost" id="bBack" type="button">Home</button></div>' +
    '<button class="card it" type="button" id="bList" style="margin-top:16px"><div class="q">' + esc(r.P.show) + '</div>' +
    (r.got.length ? '<div class="chips" style="margin-top:0">' + r.got.map(function (e) { return '<span class="chip"><i class="dot t' + e.t + '"></i>' + esc(e.name) + '</span>'; }).join('') + '</div>' : '<div class="sub">Nothing caught this time.</div>') +
    (missed.length ? '<div class="rare"><span class="lbl">You missed</span>' + missed.map(function (x) { return '<span><i class="dot t' + x.t + '"></i>' + esc(x.name) + '</span>'; }).join('') + '</div>' : '') +
    '<span class="more">All ' + fmt(r.P.all.length) + ' answers</span></button></div>';
  run = null;
  show(h);
  document.getElementById('bShare').onclick = function () { copy('Krillion Free Dive\n' + r.P.show + '\n' + r.got.length + ' answers, ' + fmt(r.score) + ' points\n' + r.got.map(function (e) { return TIERS[e.t].e; }).join(''), this); };
  document.getElementById('bAgain').onclick = startFree;
  document.getElementById('bBack').onclick = home;
  document.getElementById('bList').onclick = function () { openAnswers(r.P, null, r.got); };
}

/* ---------- every answer to a prompt ---------- */
var ansBox = document.getElementById('answers'), ansState = null;
function openAnswers(P, mine, got) {
  if (!P) return; ensure(P);
  ansState = { P: P, mine: mine, got: got || [], tier: 0 };
  document.getElementById('ansT').textContent = P.show;
  document.getElementById('ansQ').value = '';
  ansBox.hidden = false; paintAnswers();
  setTimeout(function () { try { document.getElementById('bAnsX').focus({ preventScroll: true }); } catch (e) {} }, 30);
}
function paintAnswers() {
  var st = ansState, P = st.P, q = norm(document.getElementById('ansQ').value), cnt = [0, 0, 0, 0, 0, 0, 0];
  P.all.forEach(function (e) { cnt[e.t]++; });
  var tabs = '<button class="tab' + (st.tier ? '' : ' on') + '" type="button" data-t="0">All ' + fmt(P.all.length) + '</button>';
  for (var t = 6; t >= 1; t--) if (cnt[t]) tabs += '<button class="tab' + (st.tier === t ? ' on' : '') + '" type="button" data-t="' + t + '"><i class="dot t' + t + '"></i>' + esc(TIERS[t].n) + ' ' + fmt(cnt[t]) + '</button>';
  document.getElementById('ansTabs').innerHTML = tabs;
  var list = P.all.filter(function (e) { return (!st.tier || e.t === st.tier) && (!q || e.keys.some(function (k) { return k.indexOf(q) >= 0; })); })
    .sort(function (a, b) { return b.t - a.t || (a.name < b.name ? -1 : 1); });
  var shown = list.slice(0, 400), mineK = st.mine ? norm(st.mine) : '';
  document.getElementById('ansN').textContent = fmt(list.length) + ' of ' + fmt(P.all.length) + ' answers' + (list.length > shown.length ? ', search to see the rest' : '');
  document.getElementById('ansL').innerHTML = shown.map(function (e) {
    var me = (mineK && e.keys.indexOf(mineK) >= 0) || st.got.indexOf(e) >= 0;
    return '<div class="' + (me ? 'mine' : e === P.gem ? 'gm' : '') + '"><i class="dot t' + e.t + '"></i>' + esc(e.name) + (me ? ' <span class="lbl">yours</span>' : '') + '</div>';
  }).join('') || '<div class="nt">No answers match.</div>';
  Array.prototype.forEach.call(document.querySelectorAll('#ansTabs .tab'), function (b) { b.onclick = function () { st.tier = +b.dataset.t; paintAnswers(); }; });
}
document.getElementById('ansQ').oninput = paintAnswers;
function closeAnswers() { ansBox.hidden = true; ansState = null; var b = document.getElementById('bNext'); if (b) try { b.focus({ preventScroll: true }); } catch (e) {} }
document.getElementById('bAnsX').onclick = closeAnswers;
ansBox.onclick = function (e) { if (e.target === ansBox) closeAnswers(); };

/* ---------- chrome ---------- */
var help = document.getElementById('help');
document.getElementById('tierList').innerHTML = TIERS.slice(1).map(function (t, i) { return '<div>' + pill(i + 1) + '<span class="bl">' + esc(t.b) + '</span><b>+' + t.p + '</b></div>'; }).join('');
function openHelp() { help.hidden = false; setTimeout(function () { try { document.getElementById('bHelpX').focus({ preventScroll: true }); } catch (e) {} }, 30); }
function closeHelp() { help.hidden = true; var i = document.getElementById('inp'); if (i) try { i.focus({ preventScroll: true }); } catch (e) {} }
document.getElementById('bHelp').onclick = openHelp;
document.getElementById('bHelpX').onclick = closeHelp;
help.onclick = function (e) { if (e.target === help) closeHelp(); };
var sb = document.getElementById('bSound');
function paintSound() { sb.innerHTML = soundIcon(S.sound); sb.setAttribute('aria-label', S.sound ? 'Sound on' : 'Sound off'); sb.title = S.sound ? 'Sound on' : 'Sound off'; }
sb.onclick = function () { S.sound = !S.sound; save(); paintSound(); if (S.sound) sfx('ok'); };
/* leaving a dive midway: the daily keeps its progress, other dives are dropped */
function goHome() { home(); }
/* the title leaves for the games menu */
function toMenu() { stopTimer(); try { parent.postMessage({ type: 'games-menu' }, '*'); } catch (e) {} }
document.getElementById('title').onclick = toMenu;
document.getElementById('title').onkeydown = function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toMenu(); } };
homeBtn.onclick = goHome;
document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape') { if (!ansBox.hidden) { closeAnswers(); return; } if (!help.hidden) { closeHelp(); return; } }
});

window.KR = { DATA: DATA, ensure: ensure, warm: warm, ready: function () { return anyDone; }, check: check, norm: norm, TIERS: TIERS, cur: function () { return run && run.set ? curP() : run && run.P || null; }, run: function () { return run; }, S: function () { return S; },
  dailySet: dailySet, legacySet: legacySet, today: today, fix: fix };
load(function (d) { S = fix(d); paintSound(); home(); setTimeout(function () { warm(function () {}); }, 300); });
})();
</script>
</body>
</html>

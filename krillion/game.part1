/* ---------- saves ---------- */
var framed = false; try { framed = !!(window.parent && window.parent !== window); } catch (e) { framed = true; }
var LS = GAME + '.save';
function blank() { return { v: 2, daily: null, lastDone: -1, streak: 0, bestStreak: 0, bestDaily: 0, bestEndless: 0, dives: 0, hist: {},
  arch: {}, endless: null, endlessDives: 0, freeBest: 0, freeRuns: 0, themes: {}, diver: 'helmet', sound: true }; }
var S = blank();
function fix(d) {
  var b = blank(); if (!d || typeof d !== 'object') return b;
  Object.keys(b).forEach(function (k) {
    if (d[k] == null) return;
    if (k === 'daily' || k === 'endless') { if (typeof d[k] === 'object') b[k] = d[k]; return; }
    if (typeof d[k] === typeof b[k]) b[k] = d[k];
  });

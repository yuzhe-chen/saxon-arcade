function lsGet() { try { return JSON.parse(localStorage.getItem(LS) || 'null'); } catch (e) { return null; } }
function load(cb) {
  if (!framed || window.KR_NOBRIDGE) { cb(lsGet()); return; }
  var reqId = 'kr' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7), done = false;
  function onMsg(e) {
    var m = e.data; if (!m || m.type !== 'game-load-res' || m.reqId !== reqId || done) return;
